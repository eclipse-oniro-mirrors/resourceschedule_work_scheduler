import("//build/config/features.gni")
import("//build/test.gni")
import("//foundation/resourceschedule/work_scheduler/workscheduler.gni")
module_output_path = "work_scheduler/work_scheduler"

config("worksched_private_config") {
  include_dirs = [
    "${target_gen_dir}",
    "${worksched_frameworks_path}/include",
    "${worksched_utils_path}/include",
  ]
}

##############################fuzztest##########################################
ohos_fuzztest("WorkInfoMarshallingFuzzTest") {
  module_out_path = module_output_path
  fuzz_config_file =
      "${worksched_test_path}/fuzztest/workinfomarshalling_fuzzer"

  configs = [ ":worksched_private_config" ]
  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
    "-Dprivate=public",
    "-Dprotected=public",
  ]
  sources = [ "workinfomarshalling_fuzzer.cpp" ]

  deps = [
    "${worksched_frameworks_path}:workschedclient",
    "${worksched_utils_path}:workschedutils",
  ]

  external_deps = [
    "ability_base:want",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
  ]
}
###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    # deps file
    ":WorkInfoMarshallingFuzzTest",
  ]
}
###############################################################################
