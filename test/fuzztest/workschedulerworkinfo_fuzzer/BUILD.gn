#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")
import("//foundation/resourceschedule/work_scheduler/workscheduler.gni")
module_output_path = "work_scheduler/work_scheduler"

##############################fuzztest##########################################
ohos_fuzztest("WorkSchedulerWorkInfoFuzzTest") {
  module_out_path = module_output_path
  fuzz_config_file =
      "${worksched_test_path}/fuzztest/workschedulerworkinfo_fuzzer"

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
    "-Dprivate=public",
    "-Dprotected=public",
  ]
  sources = [ "workschedulerworkinfo_fuzzer.cpp" ]

  deps = [
    "${worksched_frameworks_path}:workschedclient",
    "${worksched_utils_path}:workschedutils",
  ]

  external_deps = [
    "ability_base:want",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
  ]

  resource_config_file = "${worksched_test_path}/resource/ohos_test.xml"
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = [ ":WorkSchedulerWorkInfoFuzzTest" ]
}
###############################################################################
