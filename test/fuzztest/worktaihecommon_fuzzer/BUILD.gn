import("//build/config/features.gni")
import("//build/ohos/taihe_idl/taihe.gni")
import("//build/test.gni")
import("//foundation/resourceschedule/work_scheduler/workscheduler.gni")

module_output_path = "work_scheduler/work_scheduler"

subsystem_name = "resourceschedule"
part_name = "work_scheduler"
taihe_generated_file_path = "$taihe_file_path/out/$subsystem_name/$part_name"
taihe_toolchain_path = "//prebuilts/taihe/ohos/linux-x86_64/taihe"

config("taihe_fuzz_config") {
  include_dirs = [
    "$taihe_generated_file_path/include",
    "$taihe_toolchain_path/include",
    "${worksched_taihe_path}/work_scheduler/include",
    "${worksched_frameworks_path}/include",
    "${worksched_utils_path}/include",
  ]
}

##############################fuzztest##########################################
ohos_fuzztest("WorkTaiheCommonFuzzTest") {
  module_out_path = module_output_path
  fuzz_config_file = "${worksched_test_path}/fuzztest/worktaihecommon_fuzzer"

  configs = [ ":taihe_fuzz_config" ]
  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]
  sources = [
    "worktaihecommon_fuzzer.cpp",
    "taihe_fuzzer_stub.cpp",
    "${worksched_taihe_path}/work_scheduler/src/common.cpp",
    "$taihe_toolchain_path/src/taihe/runtime/object.cpp",
    "$taihe_toolchain_path/src/taihe/runtime/string.cpp",
  ]

  deps = [
    "${worksched_taihe_path}/work_scheduler:run_taihe",
    "${worksched_frameworks_path}:workschedclient",
    "${worksched_utils_path}:workschedutils",
  ]

  external_deps = [
    "ability_base:base",
    "ability_base:want",
    "c_utils:utils",
    "hilog:libhilog",
    "runtime_core:ani",
    "runtime_core:libarkruntime",
  ]
}
###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    # deps file
    ":WorkTaiheCommonFuzzTest",
  ]
}
###############################################################################
